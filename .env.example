# Copy to .env and adjust. Never commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
DATABASE_URL=postgres://qrumy:qrumy@localhost:5432/qrumy
REDIS_URL=redis://localhost:6379/0
# Super-admin path (keep it non-obvious in production)
QRUMY_ADMIN_PATH=qadmin/
QRUMY_ADMIN_REQUIRE_MFA=False
# Email (console backend in dev). In prod, set an anymail backend + key.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Qrumy <no-reply@qrumy.com>
# Optional Google OAuth (button is shown only when both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional error monitoring
SENTRY_DSN=
