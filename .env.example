# Copy to .env and adjust. Never commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
DATABASE_URL=postgres://qrumy:qrumy@localhost:5432/qrumy
REDIS_URL=redis://localhost:6379/0
# Super-admin path (keep it non-obvious in production)
QRUMY_ADMIN_PATH=qadmin/
QRUMY_ADMIN_REQUIRE_MFA=False
# Email via Resend (resend.com). Leave empty in development: emails are printed to the console.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Qrumy <no-reply@qrumy.com>
# Optional Google OAuth (button is shown only when both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional error monitoring
SENTRY_DSN=

# --- QR Management / analytics ---
# Base URL of dynamic QR links (printed into codes; choose it once and keep it).
QRUMY_QR_BASE_URL=http://localhost:8000/q/
# Optional MaxMind GeoLite2 City database for country/city analytics (free licence key).
QRUMY_GEOIP_CITY_DB=./var/GeoLite2-City.mmdb
# Or trust a CDN country header instead, e.g. Cloudflare: HTTP_CF_IPCOUNTRY
QRUMY_COUNTRY_HEADER=
QRUMY_SCAN_RETENTION_DAYS=180
# Optional Google Safe Browsing API key to block known-malicious destinations.
QRUMY_SAFE_BROWSING_KEY=
