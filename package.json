{
  "name": "qrumy-assets",
  "private": true,
  "description": "Build-time only: compiles Tailwind CSS and vendors front-end libraries. Not used at runtime.",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build:css": "tailwindcss -i assets/app.css -o static/dist/app.css --minify",
    "watch:css": "tailwindcss -i assets/app.css -o static/dist/app.css --watch",
    "build": "npm run vendor && npm run build:css"
  },
  "devDependencies": {
    "@alpinejs/csp": "3.17.5",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/cli": "4.3.5",
    "chart.js": "4.5.1",
    "htmx.org": "2.0.11",
    "tailwindcss": "4.3.5"
  }
}
